# ==========================================
# Society Maintenance System - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (For Docker compose, use mongodb://mongodb:27017/societyDB)
MONGODB_URI=mongodb://mongodb:27017/societyDB

# Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEB_SECRET=YOUR_WEB_SECRET

# Static UPI / VPA
VPA_ID=9898216064@axl

# Frontend API URL (for build / runtime client)
REACT_APP_API_URL=http://localhost:5000

