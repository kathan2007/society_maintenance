# ==============================================================================
# Environment Reference — Shree Hari Gift City Portal
# Security Notice: Never commit actual secret values to git.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@societydata.fw00kxp.mongodb.net/societyDB?retryWrites=true&w=majority

# JWT & Authentication Secrets (Minimum 64 bytes recommended for HMAC-SHA256)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_64_characters_long
JWT_ACCESS_SECRET=your_access_token_secret_here_at_least_64_characters_long
JWT_REFRESH_SECRET=your_refresh_token_secret_here_at_least_64_characters_long
ACCESS_TTL=15m
REFRESH_TTL=7d

# CORS Allowed Client Domains (comma-separated, without trailing slashes)
CLIENT_ORIGINS=https://society-maintenance-phi.vercel.app,http://localhost:3000
FRONTEND_URL=https://society-maintenance-phi.vercel.app

# Admin Credentials & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production
ADMIN_INVITE_CODE=generate_a_secure_random_admin_invite_token_here

# Payment Kill-Switch & Enabled Gateways
PAYMENTS_ENABLED=true
ENABLED_GATEWAYS=razorpay,stripe,upi
PAYMENT_GATEWAY=razorpay

# Razorpay Gateway
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_placeholder

# Stripe Gateway (Restricted Key recommended)
STRIPE_SECRET_KEY=rk_live_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Custom UPI Gateway
UPI_ID=society@axl
UPI_PAYEE_NAME=SHREE HARI GIFT CITY
UPI_WEBHOOK_SECRET=upi_webhook_hmac_secret_placeholder

# Monitoring & Alerting (Optional)
SENTRY_DSN=
ALERT_WEBHOOK_URL=
